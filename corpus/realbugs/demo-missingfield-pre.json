{
  "Comment": "SYNTHETIC demonstrator (pre-fix): reads a field no predecessor produced.",
  "StartAt": "Build",
  "States": {
    "Build": {
      "Type": "Pass",
      "Result": { "order": { "orderId": "o", "amount": 1 } },
      "ResultPath": "$",
      "Next": "Charge"
    },
    "Charge": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "charge", "Payload": { "total.$": "$.order.total" } },
      "End": true
    }
  }
}
